# 数据库连接（Supabase PostgreSQL）
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Direct connection to the database. Used for migrations
DIRECT_URL=
# API 鉴权 Token（自定义随机字符串，例如: openssl rand -hex 32）
BLOG_API_TOKEN=

# 博客公开地址（用于 Open Graph 和 SEO，生产环境填实际域名）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
